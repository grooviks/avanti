# Immutable image tags are set by deploy.sh. Do not use `latest` for deploys.
AVANTI_API_IMAGE=cr.yandex/<registry-id>/avanti-api
AVANTI_WEB_IMAGE=cr.yandex/<registry-id>/avanti-web
SECRETS_DIR=/opt/avanti/secrets
# Bind to loopback when Nginx runs on this VM. For a separate Nginx VM, use
# this VM's private address and allow that address through the firewall only.
AVANTI_WEB_BIND_ADDRESS=127.0.0.1
AVANTI_WEB_PORT=3001
AVANTI_SITE_URL=https://avantistyle.ru
IMAGE_TAG=
