# Скопируй в .env и подставь свои значения. Файл .env в git не коммитится.
AVANTI_DEBUG=true
# Ключ подписи JWT — минимум 32 байта. В проде обязательно свой секрет.
AVANTI_SECRET_KEY=change-me-in-env-to-a-long-random-secret-min-32-bytes
AVANTI_DATABASE_URL=postgresql+asyncpg://avanti:password@localhost:5433/avanti
AVANTI_CORS_ORIGINS=["http://localhost:3000"]
AVANTI_MEDIA_ROOT=media
AVANTI_MEDIA_URL_PREFIX=/media
AVANTI_MEDIA_MAX_UPLOAD_BYTES=10485760
# Только для scripts/migrate_legacy_catalog.py; URL старой MySQL базы.
AVANTI_LEGACY_DATABASE_URL=mysql+pymysql://avanti:password@localhost:3306/avanti
# Креды суперпользователя для scripts/create_admin.py
AVANTI_ADMIN_EMAIL=admin@avanti.app
AVANTI_ADMIN_PASSWORD=change-me
